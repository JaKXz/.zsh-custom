# Read-only GitHub CLI commands ported from ~/.claude/settings.json.
prefix_rule(
    pattern = ["gh", "auth", "status"],
    decision = "allow",
    justification = "Allow checking GitHub CLI authentication status.",
    match = ["gh auth status"],
    not_match = ["gh auth login"],
)

prefix_rule(
    pattern = ["gh", "search"],
    decision = "allow",
    justification = "Allow read-only GitHub searches.",
    match = ["gh search prs arti", "gh search issues authentication"],
    not_match = ["gh repo delete example/repo"],
)

prefix_rule(
    pattern = ["gh", "api", "user"],
    decision = "allow",
    justification = "Allow read-only GitHub user API queries.",
    match = ["gh api user", "gh api user --jq .login"],
    not_match = ["gh api repos/example/repo"],
)
prefix_rule(pattern=["git", "clone"], decision="allow")
prefix_rule(pattern=["gh", "api", "repos/sulemaanhamza/wisp", "--jq", "{default_branch,pushed_at,security_and_analysis}"], decision="allow")
prefix_rule(pattern=["gh", "pr", "view"], decision="allow")
prefix_rule(pattern=["gh", "api", "--paginate", "repos/agilebits-inc/hype-machine/pulls/3/comments", "--jq", ".[] | {id, path, line, original_line, side, start_line, original_start_line, commit_id, original_commit_id, in_reply_to_id, user: .user.login, created_at, updated_at, body, diff_hunk, html_url}"], decision="allow")
