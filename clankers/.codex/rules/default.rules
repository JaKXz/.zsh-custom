prefix_rule(pattern=["gh", "api", "--paginate", "repos/agilebits-inc/hype-machine/pulls/3/comments", "--jq", ".[] | {id, path, line, original_line, commit_id, original_commit_id, in_reply_to_id, user: .user.login, created_at, updated_at, finding: (.body | split(\"<!-- BUGBOT_BUG_ID\")[0]), diff_hunk, html_url}"], decision="allow")
prefix_rule(pattern=["gh", "api", "--paginate", "repos/agilebits-inc/hype-machine/pulls/3/comments", "--jq", ".[] | select(.id > 3905698525) | {id, path, line, commit_id, user: .user.login, created_at, finding: (.body | split(\"<!-- BUGBOT_BUG_ID\")[0]), diff_hunk, html_url}"], decision="allow")
prefix_rule(pattern=["git", "add", "--", "skills/source-work/SKILL.md"], decision="allow")
